# Modelo de embeddings que sirve TEI.
# intfloat/multilingual-e5-small produce vectores de 384 dimensiones.
# IMPORTANTE: la columna vector(384) del repositorio coolify-pgvector debe
# coincidir con la dimensión del modelo. Si cambias de modelo, cambia la dimensión.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
